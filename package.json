{
  "name": "falcon-ofis",
  "productName": "Falcon Ofis",
  "version": "1.69.0",
  "description": "Falcon Ofis - kasa, stok, malzeme ve demirbaş takip programı",
  "author": "Falcon",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/app.test.js test/electron-smoke.test.js",
    "test:electron": "node --test test/electron-smoke.test.js",
    "surum": "node araclar/surum.js",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "kopru": "node araclar/kopru.js"
  },
  "build": {
    "appId": "com.falcon.ofis",
    "productName": "Falcon Ofis",
    "copyright": "Falcon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "cekirdek/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Falcon Ofis",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "tr_TR",
        "en_US",
        "ar_SA"
      ],
      "language": "1055",
      "artifactName": "FalconOfis-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "electron": "44.11.5",
    "electron-builder": "^26.18.0"
  },
  "falconElectron": "44",
  "repository": "departures-mil/falcon-ofis"
}
